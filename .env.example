# --- DSSP Portal Login ---
# FRSC DSSP training portal login username/email
DSSP_USERNAME=<username-or-email-here>
# FRSC DSSP training portal login password
DSSP_PASSWORD=<password-here>
# Default Instructor ID fallback if auto-detection on student page fails
DEFAULT_INSTRUCTOR_ID=<instructor-id-here>

# --- Dashboard & Server Config ---
# Username to log into the web dashboard interface
DASHBOARD_USERNAME=<admin-username>
# Password to log into the web dashboard interface
DASHBOARD_PASSWORD=<admin-password>
# Secret key used by Flask for session signing (hex string or random string)
SECRET_KEY=<flask-secret-key-here>
# HTTP port for the web dashboard server to listen on
PORT=<5050>

# --- Output / Notification Settings ---
# Recipient email address for run summary completion reports
NOTIFY_EMAIL=<recipient-email@example.com>
# Outgoing SMTP server hostname for email delivery
SMTP_HOST=<smtp.example.com>
# Outgoing SMTP server port (typically 587 for TLS or 465 for SSL)
SMTP_PORT=<587>
# Username for authenticating with the SMTP server
SMTP_USER=<smtp-username-or-email>
# Password or App Password for authenticating with the SMTP server
SMTP_PASS=<smtp-password-here>
